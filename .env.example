APP_ENV=production
APP_DEBUG=false
APP_URL=https://tu-dominio.com/portales-go/public
APP_BASE_PATH=/portales-go/public
APP_TIMEZONE=America/Bogota
PANEL_ADMIN_EMAIL=admin@example.com
PANEL_ADMIN_PASSWORD=cambia-esta-clave
PANEL_LOGIN_BACKGROUND_URL=https://tu-dominio.com/imagen-login.jpg

DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=database_name
DB_USERNAME=database_user
DB_PASSWORD=database_password
DB_CHARSET=utf8mb4

API_SHARED_SECRET=cambia-este-token-largo

PROPPIT_BASE_URL=https://real-time.proppit.com/api/v2
PROPPIT_COUNTRY=CO
PROPPIT_CLIENT_ID=
PROPPIT_CLIENT_SECRET=
PROPPIT_CRM=
PROPPIT_USER=
PROPPIT_PASSWORD=
PROPPIT_PUBLISHER_EXTERNAL_ID=
PROPPIT_DEFAULT_LOCALE=es-CO
PROPPIT_DEFAULT_CURRENCY=COP
PROPPIT_CONTACT_NAME=
PROPPIT_CONTACT_EMAIL=
PROPPIT_CONTACT_PHONE=
PROPPIT_BOOSTED_QUOTA=0

FINCARAIZ_ENV=production
FINCARAIZ_API_URL=https://msi-infofinca.fincaraiz.com.co/management/api/1.0
FINCARAIZ_PAGE_URL=https://www.fincaraiz.com.co
FINCARAIZ_API_KEY=
FINCARAIZ_CLIENT_ID=
FINCARAIZ_CLIENT_AGENT=
FINCARAIZ_CONTACT_EMAIL=
FINCARAIZ_CONTACT_PHONE=
FINCARAIZ_CONTACT_WHATSAPP=
FINCARAIZ_SHOW_EXACT_ADDRESS=false
FINCARAIZ_DUAL_OFFER=rent
FINCARAIZ_AUTO_MARK=true
FINCARAIZ_QUOTA=50
FINCARAIZ_CRON_LIMIT=10
FINCARAIZ_TIMEOUT=45

# Mercado Libre Colombia (habilitar despues de autorizar la cuenta).
MERCADOLIBRE_ENABLED=false
MERCADOLIBRE_CLIENT_ID=
MERCADOLIBRE_CLIENT_SECRET=
MERCADOLIBRE_REDIRECT_URI=https://gocartagenarealestate.com/portales-go/public/panel/mercadolibre/callback
# Clave base64 de 32 bytes; mantenerla estable para descifrar los tokens.
MERCADOLIBRE_TOKEN_KEY=
MERCADOLIBRE_CRON_LIMIT=10
MERCADOLIBRE_DUAL_OFFER=sale
MERCADOLIBRE_CONTACT_NAME=Go Cartagena
MERCADOLIBRE_CONTACT_EMAIL=
MERCADOLIBRE_CONTACT_PHONE=
MERCADOLIBRE_CONTACT_WHATSAPP=
# Homologaciones opcionales JSON; usar IDs reales consultados en la API MCO.
MERCADOLIBRE_CATEGORY_MAP={}
MERCADOLIBRE_LOCATION_MAP={}
